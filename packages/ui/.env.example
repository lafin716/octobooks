# rhymehub 피드백 위젯 — 이 파일을 .env.local 로 복사해서 값을 채운다 (.env.local 은 git에 올리지 않는다)
# 키를 비워 두면 위젯 없이 앱만 동작한다.

# rhymehub 프로젝트 id (대시보드 /projects/<id>)
VITE_RHYMEHUB_PROJECT=octobooks
# 프로젝트 리포터 키 (대시보드 프로젝트 → SDK Keys). rhk_ 키만! API 토큰(rht_)은 절대 넣지 않는다.
VITE_RHYMEHUB_KEY=
# 개발 서버 /api 프록시 대상 (rhymehub 코어)
VITE_RHYMEHUB_ENDPOINT=http://127.0.0.1:7780
# 프록시 없이(예: Electron 패키징 빌드) 직접 보낼 때 rhymehub 주소. 키의 allowedOrigins에 앱 출처를 등록해야 한다.
VITE_RHYMEHUB_PUBLIC_URL=
